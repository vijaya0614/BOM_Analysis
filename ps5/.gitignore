# Secrets — never commit credentials or local env
.env
.env.*
!.env.example
!web/.env.example

# Provider caches and raw API payloads (may contain account-specific data)
data/api_cache/
data/api_raw/
data/api_status/
!data/api_cache/.gitkeep
!data/api_raw/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
*.egg-info/
.mypy_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Frontend build
web/node_modules/
web/dist/
web/dist-ssr/

# Local reports / uploads that are generated at runtime
outputs/api_reports/
outputs/api_uploads/
SENTINEL_demo_ready_validated.zip
.pytest-workspace/
