# Copy this file to .env and enter credentials only in that ignored local file.
# All provider credentials are server-side only: never use VITE_ prefixes.

# DigiKey Product Information V4
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_REFRESH_TOKEN=
DIGIKEY_ACCOUNT_ID=
# Legacy compatibility only; prefer DIGIKEY_ACCOUNT_ID. Do not leave this as 0.
DIGIKEY_CUSTOMER_ID=
DIGIKEY_ENVIRONMENT=production
DIGIKEY_API_BASE=https://api.digikey.com
DIGIKEY_SANDBOX=false

# Nexar GraphQL
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
NEXAR_ACCESS_TOKEN=
NEXAR_SCOPE=supply.domain

# Mouser Search API (paste the Search API key; MOUSER_SEARCH_API_KEY also works)
MOUSER_API_KEY=
# MOUSER_SEARCH_API_KEY=
MOUSER_API_BASE=https://api.mouser.com/api/v1

# Enrichment and cache behaviour
API_CACHE_TTL_SECONDS=86400
API_BATCH_SIZE=50
API_REQUEST_DELAY_MS=250
API_MAX_RETRIES=3
API_BACKOFF_FACTOR=2

# Default buyer market. Provider values retain their source currency.
TARGET_REGION=IN
TARGET_CURRENCY=INR

# Leave false unless deliberately running a live provider diagnostic.
RUN_LIVE_PROVIDER_TESTS=false
