FROM node:22-alpine AS builder
WORKDIR /app

# Install dependencies (package*.json)
COPY ps5/web/package*.json ./
RUN npm ci

# Copy source files
COPY ps5/web/ .

# Build the Vite app (production)
RUN npm run build

# Production image using nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Optional custom nginx config can be added
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
